#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=make_plot_pdf
#SBATCH --time=00:30:00
#SBATCH --output=./slurm_out/make_plot_pdf.out

#exit if an error occurs
set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

cd ~/ai4mi_project_group8

source activate ai4mi

python make_plot_pdf.py --model_name $MODEL_NAME
