#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=full_pipeline
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64GB
#SBATCH --time=03:00:00
#SBATCH --output=out/full_pipeline_baseline.log

module load 2023
module load Anaconda3/2023.07-2

# Change to your project directory
cd $HOME/ai4mi_project_group8/
source $(conda info --base)/etc/profile.d/conda.sh
source activate ai4mi_env
# pip install wandb
# pip install python-dotenv

# Limit BLAS threads to reduce memory pressure
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Set experiment name and seeds for reproducibility
BASE_EXPERIMENT_NAME="experiment_$(date +%Y%m%d_%H%M%S)"
SEEDS=(1 2 3)  # Use seeds that are less likely to cause CUDA issues

echo "=== Starting Full Pipeline ==="
echo "Base experiment: ${BASE_EXPERIMENT_NAME}"
echo "Seeds: ${SEEDS[@]}"

# Loop through all seeds
for SEED in "${SEEDS[@]}"; do
    echo "=== Processing Seed: ${SEED} ==="
    
    # Create unique experiment name per seed
    EXPERIMENT_NAME="${BASE_EXPERIMENT_NAME}_seed${SEED}"
    RESULTS_DIR="/home/scur1049/ai4mi_project_group8/results/${EXPERIMENT_NAME}"
    PRED_DIR="/home/scur1049/ai4mi_project_group8/data/seghtor_predictions_${SEED}"
    GT_DIR="${PRED_DIR}/gt"
    PRED_FOLDER="${PRED_DIR}/pred"
    
    echo "Results directory: ${RESULTS_DIR}"
    echo "Predictions directory: ${PRED_DIR}"
    
    # Step 1: Training 
    echo "=== Step 1: Training Model (Seed ${SEED}) ==="
    python -O main.py \
        --dataset SEGTHOR_CLEAN \
        --mode full \
        --epochs 25 \
        --dest "${RESULTS_DIR}" \
        --gpu \
        --seed ${SEED}

    if [ $? -ne 0 ]; then
        echo "ERROR: Training failed for seed ${SEED}!"
        continue
    fi

    echo "Training completed successfully for seed ${SEED}!"
    
    # Clear GPU memory after training
    echo "Clearing GPU memory..."
    python -c "import torch; torch.cuda.empty_cache(); torch.cuda.synchronize(); print('GPU memory cleared')" 2>/dev/null || echo "GPU cleanup completed"

    # Step 2: Stitch predictions
    echo "=== Step 2: Stitching Predictions (Seed ${SEED}) ==="
    python stitch.py \
      --data_folder "${RESULTS_DIR}/best_epoch/val" \
      --dest_folder "${PRED_FOLDER}" \
      --num_classes 255 \
      --grp_regex "(Patient_\\d\\d)_\\d\\d\\d\\d" \
      --source_scan_pattern "data/segthor_train/train/{id_}/GT.nii.gz"

    if [ $? -ne 0 ]; then
        echo "ERROR: Stitching failed for seed ${SEED}!"
        continue
    fi

    echo "Stitching completed successfully for seed ${SEED}!"

    # Clear GPU memory after stitching
    echo "Clearing GPU memory..."
    python -c "import torch; torch.cuda.empty_cache(); torch.cuda.synchronize(); print('GPU memory cleared')" 2>/dev/null || echo "GPU cleanup completed"

    # Step 3: Copy ground truths to seed-specific gt folder
    echo "=== Step 3: Copying Ground Truths (Seed ${SEED}) ==="
    GT_SOURCE_DIR="/home/scur1049/ai4mi_project_group8/data/segthor_fixed/train"
    
    # Create seed-specific gt directory
    mkdir -p "${GT_DIR}"

    # Copy only the ground truths for patients that were actually stitched
    # (i.e., the validation patients that have corresponding prediction files)
    echo "Looking for prediction files in: ${PRED_FOLDER}"
    pred_count=0
    for pred_file in "${PRED_FOLDER}"/*.nii.gz; do
        if [ -f "$pred_file" ]; then
            patient_name=$(basename "$pred_file" .nii.gz)
            gt_file="${GT_SOURCE_DIR}/${patient_name}/GT.nii.gz"
            
            echo "Processing prediction: ${pred_file} -> ${patient_name}"
            if [ -f "$gt_file" ]; then
                cp "$gt_file" "${GT_DIR}/${patient_name}.nii.gz"
                echo "Copied: GT.nii.gz -> ${patient_name}.nii.gz"
                pred_count=$((pred_count + 1))
            else
                echo "WARNING: Ground truth not found for ${patient_name}"
            fi
        fi
    done
    echo "Total ground truths copied: ${pred_count}"

    echo "Ground truth copying completed for seed ${SEED}!"

    # Step 4: Compute metrics for this seed
    echo "=== Step 4: Computing Metrics (Seed ${SEED}) ==="
    python compute_metrics.py \
      --ref_folder "${GT_DIR}" \
      --pred_folder "${PRED_FOLDER}" \
      --ref_extension .nii.gz \
      --pred_extension .nii.gz \
      --num_classes 5 \
      --metrics 3d_dice 3d_hd95 3d_hd 3d_assd 3d_nsd 3d_jaccard \
      --save_folder "${RESULTS_DIR}/metrics" \
      --overwrite 

    if [ $? -ne 0 ]; then
        echo "ERROR: Metrics computation failed for seed ${SEED}!"
        continue
    fi

    echo "=== Seed ${SEED} Pipeline Completed Successfully! ==="
    echo "Results saved in: ${RESULTS_DIR}"
    echo "Metrics saved in: ${RESULTS_DIR}/metrics"
    echo "Predictions saved in: ${PRED_DIR}"
done

echo "=== All Seeds Pipeline Completed! ==="
echo "All results saved in: ${BASE_RESULTS_DIR}"
echo "Individual seed results:"
for SEED in "${SEEDS[@]}"; do
    echo "  - Seed ${SEED}: ${BASE_RESULTS_DIR}/seed_${SEED}"
done
